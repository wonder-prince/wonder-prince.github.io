---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div>
			<p class="footer-kicker">TRANSMISSION COMPLETE</p>
			<p class="footer-title">保持好奇，继续创造。</p>
		</div>
		<div class="footer-meta">
			<a href="https://github.com/wonder-prince" target="_blank" rel="noreferrer">GitHub ↗</a>
			<a href="mailto:wangzinuo233@gmail.com">Email ↗</a>
			<span>© {today.getFullYear()} Wang Zinuo</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		border-top: 1px solid var(--border);
		background: rgba(4, 7, 17, 0.72);
	}

	.footer-inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
		padding: 54px 0;
	}

	.footer-kicker {
		margin: 0 0 8px;
		color: var(--cyan);
		font: 600 0.7rem/1 var(--font-mono);
		letter-spacing: 0.16em;
	}

	.footer-title {
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(1.3rem, 3vw, 2rem);
		font-weight: 650;
	}

	.footer-meta {
		display: flex;
		align-items: center;
		gap: 18px;
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	.footer-meta a {
		color: var(--text-secondary);
		text-decoration: none;
	}

	.footer-meta a:hover {
		color: var(--cyan);
	}

	@media (max-width: 720px) {
		.footer-inner,
		.footer-meta {
			align-items: flex-start;
			flex-direction: column;
		}

		.footer-meta {
			gap: 10px;
		}
	}
</style>
