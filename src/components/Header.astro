---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-nav" aria-label="主导航">
		<a class="brand" href="/" aria-label="返回首页">
			<span class="brand-mark" aria-hidden="true">WZ</span>
			<span class="brand-copy">
				<strong>INTERSTELLAR LAB</strong>
				<small>AI · ROBOTICS · CREATION</small>
			</span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/#projects">项目</HeaderLink>
			<HeaderLink href="/#journey">经历</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
			<a class="nav-cta" href="mailto:wangzinuo233@gmail.com">联系我</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		z-index: 50;
		top: 18px;
		left: 50%;
		width: min(1180px, calc(100% - 32px));
		transform: translateX(-50%);
		border: 1px solid rgba(143, 174, 255, 0.16);
		border-radius: 18px;
		background: rgba(7, 11, 24, 0.72);
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(20px) saturate(150%);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 68px;
		padding: 0 16px 0 12px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--text-primary);
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid rgba(117, 225, 255, 0.5);
		border-radius: 14px;
		background: linear-gradient(145deg, rgba(87, 218, 255, 0.2), rgba(151, 102, 255, 0.12));
		box-shadow: inset 0 0 20px rgba(92, 218, 255, 0.08);
		color: var(--cyan);
		font: 700 0.9rem/1 var(--font-mono);
		letter-spacing: -0.04em;
	}

	.brand-copy {
		display: grid;
		gap: 3px;
	}

	.brand-copy strong {
		font: 700 0.78rem/1 var(--font-mono);
		letter-spacing: 0.12em;
	}

	.brand-copy small {
		color: var(--text-muted);
		font: 500 0.58rem/1 var(--font-mono);
		letter-spacing: 0.12em;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.internal-links :global(a) {
		padding: 10px 12px;
		border-radius: 10px;
		color: var(--text-secondary);
		font: 600 0.84rem/1 var(--font-sans);
		text-decoration: none;
		transition: color 180ms ease, background 180ms ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		background: rgba(120, 169, 255, 0.1);
		color: var(--text-primary);
	}

	.internal-links .nav-cta {
		margin-left: 4px;
		border: 1px solid rgba(117, 225, 255, 0.35);
		background: rgba(117, 225, 255, 0.08);
		color: var(--cyan);
	}

	@media (max-width: 760px) {
		.site-header {
			top: 10px;
			width: calc(100% - 20px);
		}

		.site-nav {
			min-height: 58px;
		}

		.brand-mark {
			width: 36px;
			height: 36px;
		}

		.brand-copy small,
		.internal-links :global(a:not(.nav-cta)) {
			display: none;
		}

		.internal-links .nav-cta {
			margin: 0;
			padding: 9px 12px;
		}
	}
</style>
