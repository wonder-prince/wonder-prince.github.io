---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = [
	{
		date: '2025.07.27',
		title: '机械系统动力学仿真学习报告分析',
		description: '机械系统动力学、模型建立与仿真分析的学习记录。',
		tags: ['机械', '仿真'],
		href: '/2025/07/27/mechanical-system/',
	},
	{
		date: '2025.07.27',
		title: 'Nature & Humanism',
		description: '在技术与日常之间，思考自然、人文和人的位置。',
		tags: ['随笔', '人文'],
		href: '/2025/07/27/nature-and-humanlism/',
	},
	{
		date: '2025.04.08',
		title: 'GitHub Apply',
		description: '关于 GitHub 使用与实践过程的整理。',
		tags: ['GitHub', '记录'],
		href: '/2025/04/08/github-apply/',
	},
	{
		date: '2025.03.26',
		title: 'Laplace 变换的讲解',
		description: '从直觉到数学表达，重新理解 Laplace 变换。',
		tags: ['数学', 'Laplace'],
		href: '/2025/03/26/Laplace/',
	},
	{
		date: '2025.03.25',
		title: '典型建筑墙体的稳态传热分析',
		description: '建筑墙体稳态传热问题的建模与分析。',
		tags: ['传热', '建模'],
		href: '/2025/03/25/My-New-Post/',
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="探索日志 · Wang Zinuo" description="关于数学、工程、人工智能与人文的个人文章。" />
	</head>
	<body>
		<Header />
		<main class="page-shell blog-page">
			<section class="page-intro">
				<p class="eyebrow">FIELD NOTES / 探索日志</p>
				<h1 class="page-title">记录那些值得<br />继续追问的问题。</h1>
				<p class="page-lead">数学、工程、技术与人文。这里是思考留下的轨迹，也是下一次探索的起点。</p>
			</section>

			<section class="post-list" aria-label="文章列表">
				{posts.map((post, index) => (
					<a class="post-card" href={post.href}>
						<div class="post-number">{String(index + 1).padStart(2, '0')}</div>
						<div class="post-content">
							<time>{post.date}</time>
							<h2>{post.title}</h2>
							<p>{post.description}</p>
							<div class="post-tags">{post.tags.map((tag) => <span>{tag}</span>)}</div>
						</div>
						<span class="post-arrow">↗</span>
					</a>
				))}
			</section>

			<section class="archive-link">
				<p>旧版归档与分类页面仍被完整保留。</p>
				<a href="/archives/">进入历史归档 ↗</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-page {
		padding-bottom: 120px;
	}

	.post-list {
		border-top: 1px solid var(--border);
	}

	.post-card {
		display: grid;
		align-items: center;
		grid-template-columns: 64px 1fr auto;
		gap: 24px;
		padding: 34px 10px;
		border-bottom: 1px solid var(--border);
		color: inherit;
		text-decoration: none;
		transition: padding 200ms ease, background 200ms ease;
	}

	.post-card:hover {
		padding-inline: 24px;
		background: linear-gradient(90deg, rgba(116, 230, 255, 0.055), transparent);
	}

	.post-number,
	.post-content time {
		color: var(--text-muted);
		font: 550 0.66rem/1 var(--font-mono);
		letter-spacing: 0.1em;
	}

	.post-content h2 {
		margin: 9px 0 7px;
		font-size: clamp(1.4rem, 3vw, 2.25rem);
		letter-spacing: -0.035em;
	}

	.post-content p {
		margin: 0;
		color: var(--text-muted);
	}

	.post-tags {
		display: flex;
		gap: 7px;
		margin-top: 15px;
	}

	.post-tags span {
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-muted);
		font: 550 0.58rem/1 var(--font-mono);
	}

	.post-arrow {
		color: var(--cyan);
		font-size: 1.3rem;
	}

	.archive-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-top: 44px;
		padding: 25px 28px;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--surface-soft);
	}

	.archive-link p {
		margin: 0;
		color: var(--text-muted);
	}

	.archive-link a {
		font-weight: 650;
		text-decoration: none;
	}

	@media (max-width: 620px) {
		.post-card {
			grid-template-columns: 1fr auto;
		}

		.post-number {
			display: none;
		}

		.archive-link {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
