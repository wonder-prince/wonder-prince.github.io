---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
	{
		index: '01',
		title: '数学推理 Agent',
		label: 'AI AGENT · REINFORCEMENT LEARNING',
		description:
			'面向 AMC、IMO、Putnam 等竞赛题目的数学智能体探索。基于千问系列模型，以 PocketFlow 实现 RePI 架构，并引入强化学习提升可验证正确率。',
		tags: ['Qwen', 'PocketFlow', 'RePI', 'RL'],
		accent: 'cyan',
	},
	{
		index: '02',
		title: '智能座舱视觉系统',
		label: 'COMPUTER VISION · PRODUCTIZATION',
		description:
			'带领四人本科团队从零搭建视觉识别系统，为智能驾驶座舱提供感知支持；完成 SRTP 项目并继续推进创新训练与产品化。',
		tags: ['Vision', 'Edge AI', 'Team Lead'],
		accent: 'violet',
	},
	{
		index: '03',
		title: 'Robocon 机器人感知',
		label: 'ROBOTICS · SLAM · ROS',
		description:
			'围绕机器人视觉模型部署、ROS 雷达与视觉定位、SLAM 场地重建，以及深度相机和鱼眼相机数据处理开展工程实践。',
		tags: ['ROS', 'SLAM', 'Depth Camera'],
		accent: 'orange',
	},
];

const journey = [
	{
		date: 'NOW',
		title: 'AI、VLA 与机器人',
		description: '持续探索 NLP、视觉识别、具身智能与机器人技术的交叉地带。',
	},
	{
		date: '2025',
		title: '阿里巴巴 · AI 工程师',
		description: '参与数学 Agent 的开发，将模型能力、推理流程与可验证结果连接起来。',
	},
	{
		date: '2024—',
		title: 'Robocon 机器人竞赛',
		description: '将视觉、定位、SLAM 与真实机器人系统结合，在复杂场地中反复验证。',
	},
	{
		date: '2023—',
		title: '重庆大学 · 明月科创班',
		description: '从数学与工程出发，逐步形成关于人工智能、产品和创造的个人坐标系。',
	},
];

const notes = [
	{
		date: '2025.07.27',
		title: '机械系统动力学仿真学习报告分析',
		description: '从建模、运动方程到仿真结果，记录机械系统动力学的学习过程。',
		href: '/2025/07/27/mechanical-system/',
	},
	{
		date: '2025.07.27',
		title: 'Nature & Humanism',
		description: '技术之外，关于自然、人文与观察方式的一次写作。',
		href: '/2025/07/27/nature-and-humanlism/',
	},
	{
		date: '2025.03.26',
		title: 'Laplace 变换的讲解',
		description: '用更直观的方式理解 Laplace 变换及其数学意义。',
		href: '/2025/03/26/Laplace/',
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<canvas id="starfield" class="starfield" aria-hidden="true"></canvas>
				<div class="hero-grid" aria-hidden="true"></div>
				<div class="hero-glow glow-a" aria-hidden="true"></div>
				<div class="hero-glow glow-b" aria-hidden="true"></div>

				<div class="hero-content page-shell">
					<div class="hero-copy reveal">
						<p class="signal"><span></span> SIGNAL ONLINE · CHONGQING, CN</p>
						<p class="hero-kicker">你好，我是王子诺 / WANG ZINUO</p>
						<h1 id="hero-title">
							探索智能的边界，<br />
							<span>把想法变成现实。</span>
						</h1>
						<p class="hero-lead">
							AI Engineer、机器人实践者，也是一个持续写作与创造的人。关注 NLP、VLA、
							Computer Vision 和 Robotics。
						</p>
						<div class="hero-actions">
							<a class="primary-action" href="#projects">查看探索项目 <span>↘</span></a>
							<a class="secondary-action" href="https://github.com/wonder-prince" target="_blank" rel="noreferrer">
								GitHub ↗
							</a>
						</div>
						<div class="focus-list" aria-label="研究方向">
							<span>NLP</span><span>VLA</span><span>VISION</span><span>ROBOTICS</span>
						</div>
					</div>

					<div class="orbit-stage reveal" aria-label="个人视觉标识">
						<div class="orbit orbit-one"></div>
						<div class="orbit orbit-two"></div>
						<div class="orbit orbit-three"></div>
						<div class="avatar-core">
							<img src="/images/b站头像.jpg" alt="王子诺的个人头像" width="178" height="182" />
							<span class="core-pulse"></span>
						</div>
						<div class="orbit-node node-a"><span>AI</span></div>
						<div class="orbit-node node-b"><span>01</span></div>
						<div class="orbit-node node-c"><span>∞</span></div>
						<div class="telemetry telemetry-a">
							<small>CURRENT VECTOR</small>
							<strong>EMBODIED AI</strong>
						</div>
						<div class="telemetry telemetry-b">
							<small>SYSTEM STATUS</small>
							<strong>EXPLORING</strong>
						</div>
					</div>
				</div>

				<a class="scroll-cue" href="#manifesto" aria-label="继续向下浏览">
					<span>SCROLL TO EXPLORE</span><i></i>
				</a>
			</section>

			<section id="manifesto" class="manifesto section page-shell">
				<div class="section-index reveal">00 / MANIFESTO</div>
				<div class="manifesto-layout">
					<p class="manifesto-lead reveal">我相信，真正有趣的技术不只存在于论文里。</p>
					<div class="manifesto-copy reveal">
						<p>
							它应该进入真实世界，理解环境、与人协作，并最终成为一种可靠的创造工具。
							因此我在模型、机器人、数学和产品之间来回穿行。
						</p>
						<a href="/about/">读取完整个人档案 ↗</a>
					</div>
				</div>
			</section>

			<section id="projects" class="projects section page-shell">
				<div class="section-heading reveal">
					<div>
						<p class="section-index">01 / SELECTED MISSIONS</p>
						<h2>正在构建的坐标</h2>
					</div>
					<p>从算法原型到机器人现场，把抽象能力压进真实系统。</p>
				</div>

				<div class="project-grid">
					{projects.map((project) => (
						<article class:list={['project-card', `accent-${project.accent}`, 'reveal']} data-tilt>
							<div class="project-topline">
								<span>{project.index}</span>
								<i></i>
								<small>MISSION LOG</small>
							</div>
							<p class="project-label">{project.label}</p>
							<h3>{project.title}</h3>
							<p class="project-description">{project.description}</p>
							<div class="project-tags">
								{project.tags.map((tag) => <span>{tag}</span>)}
							</div>
						</article>
					))}
				</div>
			</section>

			<section id="journey" class="journey section">
				<div class="page-shell">
					<div class="section-heading reveal">
						<div>
							<p class="section-index">02 / FLIGHT PATH</p>
							<h2>成长不是直线，<br />而是一条不断校准的轨道。</h2>
						</div>
					</div>

					<div class="timeline">
						{journey.map((item, index) => (
							<article class="timeline-item reveal">
								<div class="timeline-date">{item.date}</div>
								<div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
								<div class="timeline-content">
									<h3>{item.title}</h3>
									<p>{item.description}</p>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section id="notes" class="notes section page-shell">
				<div class="section-heading reveal">
					<div>
						<p class="section-index">03 / FIELD NOTES</p>
						<h2>思考留下的航迹</h2>
					</div>
					<a class="text-link" href="/blog/">查看全部文章 ↗</a>
				</div>

				<div class="note-list">
					{notes.map((note, index) => (
						<a class="note-row reveal" href={note.href}>
							<span class="note-number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<time>{note.date}</time>
								<h3>{note.title}</h3>
								<p>{note.description}</p>
							</div>
							<span class="note-arrow">↗</span>
						</a>
					))}
				</div>
			</section>

			<section class="human section page-shell">
				<div class="human-card reveal">
					<div class="human-visual" aria-hidden="true">
						<span class="ring ring-a"></span>
						<span class="ring ring-b"></span>
						<div class="rose-frame">
							<img src="/images/rose.png" alt="" width="1000" height="750" loading="lazy" />
						</div>
					</div>
					<div class="human-copy">
						<p class="section-index">04 / BEYOND CODE</p>
						<h2>技术之外，<br />我也收集生活的回声。</h2>
						<p>
							小提琴、羽毛球、足球、写作与游戏，让理性保持温度，也让观察世界的方式不只一种。
						</p>
						<div class="interest-tags">
							<span>VIOLIN</span><span>BADMINTON</span><span>WRITING</span><span>GAMES</span>
						</div>
					</div>
				</div>
			</section>

			<section class="contact section page-shell reveal">
				<div class="contact-panel">
					<p class="section-index">05 / OPEN CHANNEL</p>
					<h2>有一个值得实现的想法？</h2>
					<p>关于 AI、机器人、研究、产品，或者只是一次有趣的交流。</p>
					<div class="contact-actions">
						<a class="primary-action" href="mailto:wangzinuo233@gmail.com">发送邮件 <span>↗</span></a>
						<a class="secondary-action" href="/Resume/">查看完整履历 ↗</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealItems = document.querySelectorAll('.reveal');
			if (reducedMotion) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}),
					{ threshold: 0.12 },
				);
				revealItems.forEach((item) => observer.observe(item));
			}

			if (!reducedMotion) {
				document.querySelectorAll('[data-tilt]').forEach((card) => {
					card.addEventListener('pointermove', (event) => {
						const rect = card.getBoundingClientRect();
						const x = (event.clientX - rect.left) / rect.width - 0.5;
						const y = (event.clientY - rect.top) / rect.height - 0.5;
						card.style.setProperty('--rx', `${-y * 5}deg`);
						card.style.setProperty('--ry', `${x * 7}deg`);
					});
					card.addEventListener('pointerleave', () => {
						card.style.setProperty('--rx', '0deg');
						card.style.setProperty('--ry', '0deg');
					});
				});
			}

			const canvas = document.getElementById('starfield');
			const context = canvas?.getContext('2d');
			if (canvas && context) {
				let width = 0;
				let height = 0;
				let stars = [];
				const resize = () => {
					const ratio = Math.min(window.devicePixelRatio || 1, 2);
					width = window.innerWidth;
					height = Math.max(window.innerHeight, 720);
					canvas.width = width * ratio;
					canvas.height = height * ratio;
					canvas.style.width = `${width}px`;
					canvas.style.height = `${height}px`;
					context.setTransform(ratio, 0, 0, ratio, 0, 0);
					const count = Math.min(150, Math.floor(width / 8));
					stars = Array.from({ length: count }, () => ({
						x: Math.random() * width,
						y: Math.random() * height,
						r: Math.random() * 1.3 + 0.2,
						a: Math.random() * 0.55 + 0.15,
						s: Math.random() * 0.004 + 0.002,
					}));
				};
				const draw = (time = 0) => {
					context.clearRect(0, 0, width, height);
					stars.forEach((star) => {
						const pulse = reducedMotion ? 1 : 0.65 + Math.sin(time * star.s + star.x) * 0.35;
						context.beginPath();
						context.fillStyle = `rgba(176, 214, 255, ${star.a * pulse})`;
						context.arc(star.x, star.y, star.r, 0, Math.PI * 2);
						context.fill();
					});
					if (!reducedMotion) requestAnimationFrame(draw);
				};
				resize();
				draw();
				window.addEventListener('resize', resize, { passive: true });
			}
		</script>
	</body>
</html>

<style>
	.hero {
		position: relative;
		display: grid;
		min-height: 100svh;
		overflow: hidden;
		place-items: center;
		background:
			linear-gradient(180deg, rgba(5, 7, 19, 0.24), #050713 96%),
			url('/images/wallhaven-wqery6-dark.webp') center/cover no-repeat;
	}

	.hero::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(5, 7, 19, 0.92) 0%, rgba(5, 7, 19, 0.62) 53%, rgba(5, 7, 19, 0.78) 100%);
		content: '';
	}

	.starfield,
	.hero-grid,
	.hero-glow {
		position: absolute;
		inset: 0;
	}

	.starfield {
		z-index: 2;
	}

	.hero-grid {
		z-index: 1;
		background-image:
			linear-gradient(rgba(116, 230, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(116, 230, 255, 0.035) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(to bottom, black 0%, transparent 88%);
	}

	.hero-glow {
		z-index: 1;
		filter: blur(20px);
		pointer-events: none;
	}

	.glow-a {
		background: radial-gradient(circle at 64% 44%, rgba(82, 155, 255, 0.2), transparent 23rem);
	}

	.glow-b {
		background: radial-gradient(circle at 84% 30%, rgba(173, 97, 255, 0.14), transparent 18rem);
	}

	.hero-content {
		position: relative;
		z-index: 4;
		display: grid;
		align-items: center;
		grid-template-columns: minmax(0, 1.25fr) minmax(380px, 0.75fr);
		gap: 48px;
		padding-top: 118px;
		padding-bottom: 94px;
	}

	.signal,
	.hero-kicker {
		font-family: var(--font-mono);
		letter-spacing: 0.13em;
	}

	.signal {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 28px;
		color: var(--text-muted);
		font-size: 0.66rem;
	}

	.signal span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #6cffbd;
		box-shadow: 0 0 14px rgba(108, 255, 189, 0.8);
		animation: blink 2s ease-in-out infinite;
	}

	.hero-kicker {
		margin-bottom: 16px;
		color: var(--cyan);
		font-size: 0.74rem;
		font-weight: 650;
	}

	h1 {
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(3.2rem, 5.2vw, 5rem);
		font-weight: 680;
		letter-spacing: -0.065em;
		line-height: 1.02;
	}

	h1 span {
		background: linear-gradient(100deg, var(--cyan), #9cb5ff 48%, #c096ff 90%);
		background-clip: text;
		color: transparent;
	}

	.hero-lead {
		max-width: 650px;
		margin: 28px 0 0;
		color: var(--text-secondary);
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		line-height: 1.85;
	}

	.hero-actions,
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 34px;
	}

	.primary-action,
	.secondary-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 26px;
		min-height: 50px;
		padding: 0 19px;
		border-radius: 13px;
		font-size: 0.88rem;
		font-weight: 650;
		text-decoration: none;
		transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
	}

	.primary-action {
		background: var(--text-primary);
		color: #070b18;
	}

	.secondary-action {
		border: 1px solid var(--border);
		background: rgba(13, 20, 42, 0.65);
		color: var(--text-primary);
	}

	.primary-action:hover,
	.secondary-action:hover {
		transform: translateY(-2px);
	}

	.secondary-action:hover {
		border-color: var(--border-bright);
	}

	.focus-list,
	.interest-tags,
	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.focus-list {
		margin-top: 28px;
	}

	.focus-list span,
	.interest-tags span,
	.project-tags span {
		padding: 7px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(13, 20, 42, 0.52);
		color: var(--text-muted);
		font: 580 0.64rem/1 var(--font-mono);
		letter-spacing: 0.08em;
	}

	.orbit-stage {
		position: relative;
		width: min(100%, 480px);
		aspect-ratio: 1;
		margin-inline: auto;
	}

	.orbit {
		position: absolute;
		inset: 50%;
		border: 1px solid rgba(130, 186, 255, 0.2);
		border-radius: 50%;
		transform: translate(-50%, -50%);
	}

	.orbit::before {
		position: absolute;
		top: -3px;
		left: 50%;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--cyan);
		box-shadow: 0 0 15px rgba(116, 230, 255, 0.9);
		content: '';
	}

	.orbit-one {
		width: 86%;
		height: 86%;
		animation: orbit-rotate 22s linear infinite;
	}

	.orbit-two {
		width: 64%;
		height: 64%;
		border-style: dashed;
		animation: orbit-rotate 16s linear reverse infinite;
	}

	.orbit-three {
		width: 44%;
		height: 44%;
		border-color: rgba(188, 135, 255, 0.22);
		animation: orbit-rotate 12s linear infinite;
	}

	.avatar-core {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 144px;
		height: 144px;
		padding: 8px;
		transform: translate(-50%, -50%);
		border: 1px solid rgba(116, 230, 255, 0.5);
		border-radius: 50%;
		background: rgba(6, 10, 22, 0.86);
		box-shadow: 0 0 70px rgba(100, 174, 255, 0.23);
	}

	.avatar-core img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}

	.core-pulse {
		position: absolute;
		inset: -12px;
		border: 1px solid rgba(116, 230, 255, 0.22);
		border-radius: 50%;
		animation: core-pulse 2.8s ease-out infinite;
	}

	.orbit-node {
		position: absolute;
		display: grid;
		width: 46px;
		height: 46px;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 15px;
		background: rgba(7, 12, 27, 0.82);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
		color: var(--cyan);
		font: 650 0.72rem/1 var(--font-mono);
	}

	.node-a { top: 9%; left: 46%; }
	.node-b { right: 4%; bottom: 29%; color: var(--violet); }
	.node-c { bottom: 5%; left: 22%; color: var(--orange); }

	.telemetry {
		position: absolute;
		min-width: 150px;
		padding: 11px 13px;
		border-left: 2px solid var(--cyan);
		background: linear-gradient(90deg, rgba(10, 18, 39, 0.88), transparent);
	}

	.telemetry small,
	.telemetry strong {
		display: block;
		font-family: var(--font-mono);
	}

	.telemetry small {
		margin-bottom: 4px;
		color: var(--text-muted);
		font-size: 0.55rem;
		letter-spacing: 0.11em;
	}

	.telemetry strong {
		color: var(--text-primary);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
	}

	.telemetry-a { top: 25%; left: 0; }
	.telemetry-b { right: -4%; bottom: 12%; border-color: var(--violet); }

	.scroll-cue {
		position: absolute;
		z-index: 5;
		bottom: 26px;
		left: 50%;
		display: flex;
		align-items: center;
		gap: 12px;
		transform: translateX(-50%);
		color: var(--text-muted);
		font: 550 0.6rem/1 var(--font-mono);
		letter-spacing: 0.13em;
		text-decoration: none;
	}

	.scroll-cue i {
		width: 48px;
		height: 1px;
