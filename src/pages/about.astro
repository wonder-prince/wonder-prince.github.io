---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="关于王子诺 · Interstellar Lab"
			description="王子诺的个人介绍、研究方向、工程经历与兴趣。"
		/>
	</head>
	<body>
		<Header />
		<main class="about-page page-shell">
			<section class="page-intro about-intro">
				<div>
					<p class="eyebrow">PERSONAL DOSSIER / 个人档案</p>
					<h1 class="page-title">在模型与机器之间，<br />寻找真实的智能。</h1>
					<p class="page-lead">
						我是王子诺，重庆大学明月科创班人工智能方向学生。关注 NLP、VLA、视觉识别和机器人技术，也在写作、音乐与运动中保持对世界的感受力。
					</p>
				</div>
				<div class="portrait-card glass-panel">
					<img src="/images/b站头像.jpg" alt="王子诺的个人头像" width="178" height="182" />
					<div>
						<small>CALL SIGN</small>
						<strong>兮落 / WONDER-PRINCE</strong>
						<span>CHONGQING · CHINA</span>
					</div>
				</div>
			</section>

			<section class="profile-grid">
				<article class="profile-card glass-panel">
					<p class="eyebrow">01 / CURRENT FOCUS</p>
					<h2>研究方向</h2>
					<p>NLP、VLA、计算机视觉、机器人技术，以及模型能力走向真实产品的完整链路。</p>
					<div class="tag-list"><span>NLP</span><span>VLA</span><span>CV</span><span>ROBOTICS</span></div>
				</article>
				<article class="profile-card glass-panel">
					<p class="eyebrow">02 / EXPERIENCE</p>
					<h2>工程实践</h2>
					<p>参与数学 Agent、智能座舱视觉、Robocon 机器人感知、SLAM 与多相机数据处理。</p>
					<a href="/Resume/">查看完整履历 ↗</a>
				</article>
			</section>

			<section class="about-section">
				<p class="eyebrow">03 / HOW I WORK</p>
				<div class="split-copy">
					<h2>让好奇心先出发，<br />再用工程把它带回来。</h2>
					<div class="prose">
						<p>
							我喜欢从一个真实问题开始：它为什么困难？模型缺失了什么能力？系统真正需要怎样的信息？然后在论文、代码、传感器和用户需求之间寻找答案。
						</p>
						<p>
							对我来说，完成一个项目不只是跑通指标，也包括理解失败、整理方法、和团队一起把方案推向更可靠的状态。
						</p>
					</div>
				</div>
			</section>

			<section class="about-section recognitions">
				<p class="eyebrow">04 / MILESTONES</p>
				<h2>部分经历与荣誉</h2>
				<div class="recognition-list">
					<div><span>2025</span><p>重庆市三好学生</p></div>
					<div><span>2024</span><p>国家奖学金</p></div>
					<div><span>2024—2025</span><p>全国大学生机器人大赛 Robocon 全国三等奖</p></div>
					<div><span>2025</span><p>美国大学生数学建模大赛 H 奖</p></div>
				</div>
			</section>

			<section class="about-section contact-strip glass-panel">
				<div>
					<p class="eyebrow">OPEN CHANNEL</p>
					<h2>一起创造些有意思的东西。</h2>
				</div>
				<div class="contact-links">
					<a href="mailto:wangzinuo233@gmail.com">Email ↗</a>
					<a href="https://github.com/wonder-prince" target="_blank" rel="noreferrer">GitHub ↗</a>
					<a href="https://www.seyoinnovation.cn/" target="_blank" rel="noreferrer">汐游创新 ↗</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		padding-bottom: 120px;
	}

	.about-intro {
		display: grid;
		align-items: end;
		grid-template-columns: 1fr 280px;
		gap: 70px;
	}

	.portrait-card {
		padding: 18px;
	}

	.portrait-card img {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 18px;
		object-fit: cover;
	}

	.portrait-card div {
		display: grid;
		gap: 5px;
		padding: 16px 3px 4px;
	}

	.portrait-card small,
	.portrait-card span {
		color: var(--text-muted);
		font: 550 0.62rem/1.3 var(--font-mono);
		letter-spacing: 0.1em;
	}

	.portrait-card strong {
		color: var(--text-primary);
		font-size: 0.88rem;
	}

	.profile-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.profile-card {
		padding: clamp(28px, 5vw, 48px);
	}

	.profile-card h2,
	.about-section h2 {
		margin: 0 0 20px;
		font-size: clamp(2rem, 4vw, 3.4rem);
		letter-spacing: -0.05em;
	}

	.profile-card > p:not(.eyebrow) {
		color: var(--text-secondary);
	}

	.profile-card a {
		font-weight: 650;
		text-decoration: none;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 28px;
	}

	.tag-list span {
		padding: 7px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-muted);
		font: 550 0.64rem/1 var(--font-mono);
	}

	.about-section {
		padding-top: 120px;
	}

	.split-copy {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 80px;
	}

	.split-copy h2 {
		margin: 0;
	}

	.recognition-list {
		border-top: 1px solid var(--border);
	}

	.recognition-list div {
		display: grid;
		grid-template-columns: 180px 1fr;
		padding: 24px 8px;
		border-bottom: 1px solid var(--border);
	}

	.recognition-list span {
		color: var(--cyan);
		font: 600 0.75rem/1.7 var(--font-mono);
	}

	.recognition-list p {
		margin: 0;
		color: var(--text-primary);
		font-size: 1.08rem;
	}

	.contact-strip {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 48px;
		margin-top: 120px;
		padding: clamp(30px, 6vw, 64px);
	}

	.contact-strip h2 {
		margin: 0;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
	}

	.contact-links a {
		font-size: 0.9rem;
		font-weight: 650;
		text-decoration: none;
	}

	@media (max-width: 800px) {
		.about-intro,
		.profile-grid,
		.split-copy {
			grid-template-columns: 1fr;
		}

		.portrait-card {
			max-width: 320px;
		}

		.about-section {
			padding-top: 82px;
		}

		.contact-strip {
			align-items: flex-start;
			flex-direction: column;
			margin-top: 82px;
		}
	}

	@media (max-width: 560px) {
		.recognition-list div {
			grid-template-columns: 1fr;
			gap: 8px;
		}
	}
</style>
